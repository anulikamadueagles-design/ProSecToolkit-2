name: ProSecToolkit Release Build

on:
  workflow_dispatch:
  push:
    branches:
      - main

permissions:
  contents: read

jobs:
  build:
    name: Build Signed ProSecToolkit
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Java 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Python 3.13
        uses: actions/setup-python@v5
        with:
          python-version: '3.13'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '9.4.1'

      - name: Find ProSecToolkit package
        shell: bash
        run: |
          set -e

          ZIP=$(find . -type f \
            -name 'ProSecToolkit-v1.2.1-Vector-Elements-Tech.zip' \
            | head -n 1)

          if [ -z "$ZIP" ]; then
            echo "ERROR: ProSecToolkit ZIP not found."
            exit 1
          fi

          mkdir -p package
          unzip -q "$ZIP" -d package

      - name: Find Android project
        shell: bash
        run: |
          set -e

          SETTINGS=$(find package -type f \
            \( -name 'settings.gradle' -o -name 'settings.gradle.kts' \) \
            | head -n 1)

          if [ -z "$SETTINGS" ]; then
            echo "ERROR: Android Gradle project not found."
            exit 1
          fi

          ANDROID_DIR=$(dirname "$SETTINGS")

          echo "ANDROID_DIR=$ANDROID_DIR" >> "$GITHUB_ENV"

      - name: Decode signing keystore
        shell: bash
        run: |
          echo "${{ secrets.KEYSTORE_BASE64 }}" | base64 --decode > signing.jks

      - name: Build signed APK and AAB
        working-directory: ${{ env.ANDROID_DIR }}
        env:
          KEYSTORE_PASSWORD: ${{ secrets.KEYSTORE_PASSWORD }}
          KEY_ALIAS: ${{ secrets.KEY_ALIAS }}
          KEYSTORE_FILE: ${{ github.workspace }}/signing.jks
        shell: bash
        run: |
          set -e

          if [ -f "./gradlew" ]; then
            chmod +x ./gradlew
            ./gradlew assembleRelease bundleRelease
          else
            gradle assembleRelease bundleRelease
          fi

      - name: Upload release APK
        uses: actions/upload-artifact@v4
        with:
          name: ProSecToolkit-v1.2.1-release-APK
          path: ${{ env.ANDROID_DIR }}/app/build/outputs/apk/release/*.apk
          if-no-files-found: error

      - name: Upload Google Play AAB
        uses: actions/upload-artifact@v4
        with:
          name: ProSecToolkit-v1.2.1-release-AAB
          path: ${{ env.ANDROID_DIR }}/app/build/outputs/bundle/release/*.aab
          if-no-files-found: error
